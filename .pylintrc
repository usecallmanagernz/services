[MASTER]
persistent=no
extension-pkg-whitelist=lxml

[MESSAGES CONTROL]
disable=missing-module-docstring,missing-class-docstring,missing-function-docstring,invalid-name,unused-argument,line-too-long,len-as-condition,duplicate-code,assigning-non-slot,redefined-builtin,consider-iterating-dictionary,not-callable,too-many-locals,too-many-statements,too-many-branches,broad-exception-raised,broad-exception-caught,consider-using-f-string,consider-using-enumerate,too-many-return-statements,redefined-argument-from-local

[REPORTS]
output-format=text
